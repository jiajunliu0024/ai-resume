{
  "manifest_version": 3,
  "name": "Resume Tailor",
  "description": "Tailor resumes and cover letters from the current job description.",
  "version": "0.1.1",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-src 'self' blob: data:; worker-src 'self'"
  },
  "icons": {
    "16": "resume-tailor-r-icon-16.png",
    "32": "resume-tailor-r-icon-32.png",
    "48": "resume-tailor-r-icon-48.png",
    "128": "resume-tailor-r-icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "resume-tailor-r-icon-16.png",
      "32": "resume-tailor-r-icon-32.png",
      "48": "resume-tailor-r-icon-48.png",
      "128": "resume-tailor-r-icon-128.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "content_scripts": [
    {
      "matches": [
        "*://*.seek.com.au/*",
        "*://*.seek.com/*",
        "*://www.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.jora.com/*"
      ],
      "js": ["assets/floatingWidget.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.mistral.ai/*",
    "https://api.x.ai/*",
    "https://openrouter.ai/*",
    "https://api.together.xyz/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*", "resume-templates/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
